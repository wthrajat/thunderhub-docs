    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "husky": "^9",
    "lint-staged": "^15",
    "pagefind": "^1",
    "prettier": "^3",
    "typescript": "^5"
  }
