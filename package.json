  "scripts": {
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "dev": "next dev --turbopack",
    "format": "npx prettier --write .",
    "lint": "next lint",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "start": "next start"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "next": "^15",
    "nextra": "^4",
    "nextra-theme-docs": "^4",
